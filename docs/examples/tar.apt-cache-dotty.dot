digraph packages {
concentrate=true;
size="30,40";
"tar" -> "libacl1"[color=blue];
"tar" -> "libc6"[color=blue];
"tar" -> "libselinux1"[color=blue];
"tar" -> "cpio"[color=springgreen];
"tar" -> "dpkg-dev"[color=springgreen];
"libc6" -> "libgcc-s1";
"libc6" -> "chrony"[color=springgreen];
"libc6" -> "cyrus-imapd"[color=springgreen];
"libc6" -> "fakechroot"[color=springgreen];
"libc6" -> "firefox"[color=springgreen];
"libc6" -> "firefox-esr"[color=springgreen];
"libc6" -> "gnumach-image-1.8-486"[color=springgreen];
"libc6" -> "gnumach-image-1.8-486-dbg"[color=springgreen];
"libc6" -> "gnumach-image-1.8-xen-486"[color=springgreen];
"libc6" -> "gnumach-image-1.8-xen-486-dbg"[color=springgreen];
"libc6" -> "hurd"[color=springgreen];
"libc6" -> "locales"[color=springgreen];
"libc6" -> "locales-all"[color=springgreen];
"libc6" -> "nscd"[color=springgreen];
"libc6" -> "python3-iptables"[color=springgreen];
"libc6" -> "scipy"[color=springgreen];
"libc6" -> "tinydns"[color=springgreen];
"libc6" -> "valgrind"[color=springgreen];
"libgcc-s1" -> "gcc-14-base";
"libgcc-s1" -> "libc6";
"libacl1" -> "libc6";
"libselinux1" -> "libc6";
"libselinux1" -> "libpcre2-8-0";
"libpcre2-8-0" -> "libc6";
"gcc-14-base" -> "gnat"[color=springgreen];
"libacl1" [shape=box];
"chrony" [shape=hexagon];
"fakechroot" [shape=hexagon];
"libselinux1" [shape=box];
"tar" [shape=box];
"gnumach-image-1.8-486-dbg" [shape=hexagon];
"gnumach-image-1.8-486" [shape=hexagon];
"locales-all" [shape=hexagon];
"firefox" [shape=hexagon];
"libc6" [shape=box];
"locales" [color=orange,shape=box];
"dpkg-dev" [color=orange,shape=box];
"cyrus-imapd" [shape=hexagon];
"gnat" [shape=hexagon];
"python3-iptables" [shape=hexagon];
"scipy" [shape=hexagon];
"libpcre2-8-0" [shape=box];
"gnumach-image-1.8-xen-486" [shape=hexagon];
"hurd" [shape=hexagon];
"cpio" [shape=hexagon];
"nscd" [shape=hexagon];
"gnumach-image-1.8-xen-486-dbg" [shape=hexagon];
"firefox-esr" [shape=hexagon];
"valgrind" [color=orange,shape=box];
"tinydns" [shape=hexagon];
"gcc-14-base" [shape=box];
"libgcc-s1" [shape=box];
}
